{
  "name": "city-council",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @city-council/client dev",
    "test": "pnpm -r --parallel --if-present test",
    "lint": "eslint . --max-warnings 0 && node scripts/check-lint-rules.mjs && node scripts/check-node-version.mjs && node scripts/check-e2e-timeouts.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:ci": "pnpm verify && pnpm soak && pnpm bench",
    "build": "pnpm typecheck && pnpm --filter @city-council/client build",
    "e2e": "playwright test",
    "e2e:shard": "node scripts/e2e-shard-run.mjs",
    "soak": "pnpm --filter @city-council/client soak",
    "bench": "pnpm -r --workspace-concurrency=1 --no-bail --if-present bench",
    "balance": "node scripts/balance.mjs",
    "prepare": "node scripts/git-setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
